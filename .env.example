# LiteLLM reads provider credentials from their standard environment variables.
# Set only the providers you intend to run. Never commit real keys.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Native Tinker manifests refer only to these variable names.
TINKER_API_KEY=
TINKER_PROJECT_ID=
